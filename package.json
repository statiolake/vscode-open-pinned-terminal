{
  "name": "vscode-open-pinned-terminal",
  "displayName": "Open Pinned Terminal",
  "description": "Open or focus a pinned terminal in the editor area",
  "version": "0.2.0",
  "publisher": "statiolake",
  "repository": {
    "type": "git",
    "url": "https://github.com/statiolake/vscode-open-pinned-terminal"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "open-pinned-terminal.open",
        "title": "Open Pinned Terminal"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:build",
    "compile": "npm run check-types && node esbuild.js",
    "package:build": "npm run check-types && node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "package": "vsce package",
    "publish": "npm run publish:vsce && npm run publish:ovsx",
    "publish:vsce": "vsce publish",
    "publish:ovsx": "ovsx publish"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "ovsx": "^1.1.1"
  }
}
